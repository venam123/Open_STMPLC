			(dxfusepcbnewfont yes)
			(psnegative no)
			(psa4output no)
			(plot_black_and_white yes)
			(sketchpadsonfab no)
			(plotpadnumbers no)
			(hidednponfab no)
			(sketchdnponfab yes)
			(crossoutdnponfab yes)
			(subtractmaskfromsilk no)
			(outputformat 3)
			(mirror no)
			(drillshape 0)
			(scaleselection 1)
			(outputdirectory "D:/Github/Open_STMPLC/Hardware/Running_Hardware/Open_STMPLC_IO_V0.1/DXF_Plot/")
